# =============================================================
# Face Attendance System — Environment Variable Reference
# =============================================================
# Copy this file to `.env` and fill in your local values.
# `.env` is listed in .gitignore and must NOT be committed.
# This file (.env.example) is safe to commit — it contains no
# real credentials, only documented defaults.
# =============================================================

# ── App identity ────────────────────────────────────────────
APP_NAME=Face Attendance System
APP_VERSION=4.4.0

# Set to "production" to disable debug mode and hot reload
APP_ENV=development

# Override individual flags (default follows APP_ENV)
# DEBUG=false
# UVICORN_RELOAD=false
# API_DOCS_ENABLED=false

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Camera ───────────────────────────────────────────────────
# 0 = default webcam; use an RTSP/MJPEG/HTTP URL for IP cameras
# CAMERA_SOURCE=0
#
# Optional 2-phone Android/IP camera demo sources. Common Android IP camera
# apps expose MJPEG as http://PHONE_IP:PORT/video; use the exact URL shown by
# your app if different.
# DUAL_CAMERA_LEFT_SOURCE=http://192.168.1.21:8080/video
# DUAL_CAMERA_RIGHT_SOURCE=http://192.168.1.22:8080/video
#
# Two-Logitech-C270 stereo demo defaults on Raspberry Pi 4:
# DUAL_CAMERA_LEFT_SOURCE=0
# DUAL_CAMERA_RIGHT_SOURCE=1
# DUAL_CAMERA_WIDTH=640
# DUAL_CAMERA_HEIGHT=480
# DUAL_CAMERA_FPS=15
# DUAL_CAMERA_FOURCC=MJPG
# DUAL_CAMERA_BACKEND=auto
# On Windows with two Logitech C270 devices, DirectShow is more stable:
# DUAL_CAMERA_BACKEND=dshow
#
# Static alignment measured for the current stereo rig. It shifts cam0/left down
# 14px, cam1/right up 14px, then crops the clean shared 640x452 region.
# STEREO_ALIGNMENT_ENABLED=true
# STEREO_ALIGN_LEFT_DX=0
# STEREO_ALIGN_LEFT_DY=14
# STEREO_ALIGN_RIGHT_DX=0
# STEREO_ALIGN_RIGHT_DY=-14
# STEREO_ALIGN_CROP_X_START=0
# STEREO_ALIGN_CROP_X_END=640
# STEREO_ALIGN_CROP_Y_START=14
# STEREO_ALIGN_CROP_Y_END=466
#
# Fail-safe stereo liveness demo tuning. The endpoint returns
# LIVE / SPOOF / INCONCLUSIVE and should stay INCONCLUSIVE when frame pairing,
# blur, landmarks, or geometry are not clean enough.
# STEREO_LIVENESS_SAMPLE_COUNT=5
# STEREO_LIVENESS_MIN_VOTES=3
# STEREO_LIVENESS_MIN_LIVE_VOTES=3
# STEREO_LIVENESS_SPOOF_SUPPRESS_SECONDS=0.0
# STEREO_LIVENESS_PLANAR_RESIDUAL_PCT_MAX=1.1
# STEREO_LIVENESS_LIVE_H_INLIER_MAX=0.75
# STEREO_LIVENESS_LIVE_H_RESIDUAL_PCT_MIN=1.7
# STEREO_LIVENESS_WARMUP_SECONDS=2.0
# STEREO_LIVENESS_MAX_HOST_SKEW_MS=120
# STEREO_LIVENESS_MAX_FRAME_AGE_SECONDS=1.0
# STEREO_LIVENESS_LOG_JSON=true

# Treat camera startup failure as a fatal error
# CAMERA_REQUIRED=false

# ── Model loading ────────────────────────────────────────────
# AUTO_PRELOAD_MODELS=true
# AUTO_LOAD_EMBEDDING_CACHE=true
# AUTO_START_CAMERA=true

# ── CORS / trusted hosts (comma-separated) ───────────────────
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://other.com
# TRUSTED_HOSTS=yourdomain.com,other.com
